{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["server", "src/lib/model.ts", "src/lib/scoring.ts", "src/lib/format.ts", "src/lib/protocol.ts"]
}
